# Copy to .env for local runs. Environment variables override this file.

APP_NAME=php-service
APP_ENV=local
APP_DEBUG=true
SERVER_PORT=8088
LOG_LEVEL=debug

MONGODB_URI=mongodb://localhost:27017/docker

# JWT verification: set one of these (see README).
COM_MICROSERVICE_AUTHENTICATION_JWK_KEY_SET_URI=http://localhost:9999/.well-known/jwks.json
# COM_MICROSERVICE_AUTHENTICATION_JWT_KEY_VALUE=
# COM_MICROSERVICE_AUTHENTICATION_JWT_ALLOW_UNVERIFIED=false

CONSUL_ENABLED=false
CONSUL_URL=http://localhost:8500
SPRING_PROFILES_ACTIVE=dev
HOST_NAME=localhost
